{
  "name": "medisync-sdk-tools",
  "private": true,
  "description": "Tools of the MediSync SDK repository: spec sync, code generator, mock server, leak check. Not published.",
  "type": "module",
  "scripts": {
    "specs:sync": "bun scripts/specs-sync.ts",
    "specs:check": "bun scripts/specs-sync.ts --check",
    "generate": "bun generator/src/main.ts",
    "generate:check": "bun generator/src/main.ts --check",
    "mock": "bun conformance/mock/server.ts",
    "test": "bun test generator",
    "leak-check": "bun release/leak-check.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.12"
  }
}
