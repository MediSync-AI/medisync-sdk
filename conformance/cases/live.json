{
  "cases": [
    {
      "name": "handshake with the API key, config defaults, session_ready first",
      "steps": [
        {
          "open": {
            "config": {
              "language": "de"
            }
          }
        },
        {
          "close": {}
        }
      ],
      "expect": {
        "connections": [
          {
            "headers": {
              "authorization": "Bearer msk_test_conformance",
              "medisync-version": "2026-11-01"
            },
            "absentQuery": [
              "token"
            ],
            "config": {
              "type": "config",
              "language": "de",
              "audio": {
                "encoding": "pcm_s16le",
                "sample_rate": 16000,
                "channels": 1
              },
              "timeline_offset_seconds": 0
            }
          }
        ],
        "eventTypes": [
          "session_ready"
        ]
      }
    },
    {
      "name": "a stream token goes in the query, not as a header",
      "steps": [
        {
          "open": {
            "token": "mst_conformance_token"
          }
        },
        {
          "close": {}
        }
      ],
      "expect": {
        "connections": [
          {
            "query": {
              "token": "mst_conformance_token"
            },
            "absentHeaders": [
              "authorization"
            ]
          }
        ]
      }
    },
    {
      "name": "audio, terms, end_utterance: the last transcripts, then flushed, then close",
      "steps": [
        {
          "open": {}
        },
        {
          "setTerms": [
            "Ramipril",
            "Bisoprolol"
          ]
        },
        {
          "sendAudio": {
            "seconds": 2.5,
            "frameSeconds": 0.1
          }
        },
        {
          "finish": {}
        }
      ],
      "expect": {
        "eventTypes": [
          "session_ready",
          "transcript",
          "transcript",
          "ack",
          "transcript",
          "flushed"
        ],
        "lastSegmentEnd": 2.5,
        "connections": [
          {
            "audioBytes": 80000,
            "messageTypes": [
              "config",
              "terms",
              "end_utterance",
              "close"
            ],
            "terms": [
              "Ramipril",
              "Bisoprolol"
            ]
          }
        ],
        "finishMs": {
          "max": 2000
        }
      }
    },
    {
      "name": "flushed right after the ack (silent tail): finish ends at once",
      "ws": {
        "endUtterance": {
          "replies": [
            [
              "ack",
              "flushed"
            ]
          ]
        }
      },
      "steps": [
        {
          "open": {}
        },
        {
          "sendAudio": {
            "seconds": 2.5,
            "frameSeconds": 0.1
          }
        },
        {
          "finish": {}
        }
      ],
      "expect": {
        "eventTypes": [
          "session_ready",
          "transcript",
          "transcript",
          "ack",
          "flushed"
        ],
        "lastSegmentEnd": 2.0,
        "finishMs": {
          "max": 1500
        },
        "connections": [
          {
            "messageTypes": [
              "config",
              "end_utterance",
              "close"
            ]
          }
        ]
      }
    },
    {
      "name": "two end_utterance: finish waits for the second flushed, not the first",
      "ws": {
        "endUtterance": {
          "replies": [
            [
              "ack",
              "tail",
              {
                "delayMs": 400
              },
              "flushed"
            ],
            [
              {
                "delayMs": 100
              },
              "ack",
              "tail",
              {
                "delayMs": 800
              },
              "flushed"
            ]
          ]
        }
      },
      "steps": [
        {
          "open": {}
        },
        {
          "sendAudio": {
            "seconds": 1.5,
            "frameSeconds": 0.1
          }
        },
        {
          "endUtterance": {}
        },
        {
          "sendAudio": {
            "seconds": 1.0,
            "frameSeconds": 0.1
          }
        },
        {
          "finish": {}
        }
      ],
      "expect": {
        "eventTypes": [
          "session_ready",
          "transcript",
          "ack",
          "transcript",
          "transcript",
          "ack",
          "flushed",
          "flushed"
        ],
        "lastSegmentEnd": 2.5,
        "finishMs": {
          "min": 700,
          "max": 3000
        },
        "connections": [
          {
            "messageTypes": [
              "config",
              "end_utterance",
              "end_utterance",
              "close"
            ]
          }
        ]
      }
    },
    {
      "name": "no flushed (server before 23.11.2026): after the timeout, a transcript at the ack ends the stream",
      "ws": {
        "endUtterance": {
          "replies": [
            [
              "ack",
              "tail"
            ]
          ]
        }
      },
      "steps": [
        {
          "open": {}
        },
        {
          "sendAudio": {
            "seconds": 2.5,
            "frameSeconds": 0.1
          }
        },
        {
          "finish": {
            "flushTimeoutMs": 500
          }
        }
      ],
      "expect": {
        "eventTypes": [
          "session_ready",
          "transcript",
          "transcript",
          "ack",
          "transcript"
        ],
        "lastSegmentEnd": 2.5,
        "finishMs": {
          "min": 450,
          "max": 2500
        },
        "connections": [
          {
            "messageTypes": [
              "config",
              "end_utterance",
              "close"
            ]
          }
        ]
      }
    },
    {
      "name": "no flushed and a silent tail: after the timeout, 3 s without a message end the stream",
      "ws": {
        "endUtterance": {
          "replies": [
            [
              "ack"
            ]
          ]
        }
      },
      "steps": [
        {
          "open": {}
        },
        {
          "sendAudio": {
            "seconds": 2.5,
            "frameSeconds": 0.1
          }
        },
        {
          "finish": {
            "flushTimeoutMs": 500
          }
        }
      ],
      "expect": {
        "eventTypes": [
          "session_ready",
          "transcript",
          "transcript",
          "ack"
        ],
        "lastSegmentEnd": 2.0,
        "finishMs": {
          "min": 2900,
          "max": 6000
        },
        "connections": [
          {
            "messageTypes": [
              "config",
              "end_utterance",
              "close"
            ]
          }
        ]
      }
    },
    {
      "name": "the server closes before flushed: finish ends without an error",
      "ws": {
        "endUtterance": {
          "replies": [
            [
              "ack",
              "tail",
              {
                "close": 1000
              }
            ]
          ]
        }
      },
      "steps": [
        {
          "open": {}
        },
        {
          "sendAudio": {
            "seconds": 2.5,
            "frameSeconds": 0.1
          }
        },
        {
          "finish": {}
        }
      ],
      "expect": {
        "eventTypes": [
          "session_ready",
          "transcript",
          "transcript",
          "ack",
          "transcript"
        ],
        "lastSegmentEnd": 2.5,
        "finishMs": {
          "max": 2000
        },
        "connectionCount": 1
      }
    },
    {
      "name": "speaker roles: the final speaker_roles after flushed is delivered before the close",
      "ws": {
        "endUtterance": {
          "replies": [
            [
              "ack",
              "tail",
              "flushed",
              {
                "delayMs": 300
              },
              "rolesFinal"
            ]
          ]
        }
      },
      "steps": [
        {
          "open": {
            "config": {
              "diarization": {
                "enabled": true
              },
              "speaker_roles": true
            }
          }
        },
        {
          "sendAudio": {
            "seconds": 2.5,
            "frameSeconds": 0.1
          }
        },
        {
          "finish": {}
        }
      ],
      "expect": {
        "eventTypes": [
          "session_ready",
          "transcript",
          "transcript",
          "ack",
          "transcript",
          "flushed",
          "speaker_roles"
        ],
        "finishMs": {
          "min": 250,
          "max": 2500
        },
        "connections": [
          {
            "messageTypes": [
              "config",
              "end_utterance",
              "close"
            ]
          }
        ]
      }
    },
    {
      "name": "speaker roles on but no final speaker_roles: finish ends 3 s after flushed",
      "steps": [
        {
          "open": {
            "config": {
              "diarization": {
                "enabled": true
              },
              "speaker_roles": true
            }
          }
        },
        {
          "sendAudio": {
            "seconds": 2.5,
            "frameSeconds": 0.1
          }
        },
        {
          "finish": {}
        }
      ],
      "expect": {
        "eventTypes": [
          "session_ready",
          "transcript",
          "transcript",
          "ack",
          "transcript",
          "flushed"
        ],
        "finishMs": {
          "min": 2900,
          "max": 6000
        }
      }
    },
    {
      "name": "asr_failed is not fatal: an error event, then flushed, and the stream ends normally",
      "ws": {
        "endUtterance": {
          "replies": [
            [
              "ack",
              {
                "send": {
                  "type": "error",
                  "code": "asr_failed",
                  "message": "Mock asr_failed.",
                  "param": null,
                  "request_id": null,
                  "fatal": false
                }
              },
              "flushed"
            ]
          ]
        }
      },
      "steps": [
        {
          "open": {}
        },
        {
          "sendAudio": {
            "seconds": 2.5,
            "frameSeconds": 0.1
          }
        },
        {
          "finish": {}
        }
      ],
      "expect": {
        "eventTypes": [
          "session_ready",
          "transcript",
          "transcript",
          "ack",
          "error",
          "flushed"
        ],
        "lastSegmentEnd": 2.0,
        "finishMs": {
          "max": 2000
        }
      }
    },
    {
      "name": "after a fatal worker_lost the stream continues from the last segment end",
      "ws": {
        "fatal": {
          "connection": 1,
          "afterSeconds": 1.5,
          "code": "worker_lost"
        }
      },
      "steps": [
        {
          "open": {}
        },
        {
          "sendAudio": {
            "seconds": 2.5,
            "frameSeconds": 0.1
          }
        },
        {
          "finish": {}
        }
      ],
      "expect": {
        "connectionCount": 2,
        "eventTypesInclude": [
          "reconnecting"
        ],
        "lastSegmentEnd": 2.5,
        "connections": [
          {},
          {
            "config": {
              "timeline_offset_seconds": 1
            },
            "firstAudioAt": 1,
            "audioBytes": 48000
          }
        ]
      }
    },
    {
      "name": "the wordbook is sent again after a reconnect",
      "ws": {
        "fatal": {
          "connection": 1,
          "afterSeconds": 1.5,
          "code": "worker_lost"
        }
      },
      "steps": [
        {
          "open": {}
        },
        {
          "setTerms": [
            "Ramipril"
          ]
        },
        {
          "sendAudio": {
            "seconds": 2.5,
            "frameSeconds": 0.1
          }
        },
        {
          "finish": {}
        }
      ],
      "expect": {
        "connectionCount": 2,
        "lastSegmentEnd": 2.5,
        "connections": [
          {
            "terms": [
              "Ramipril"
            ]
          },
          {
            "terms": [
              "Ramipril"
            ],
            "config": {
              "timeline_offset_seconds": 1
            }
          }
        ]
      }
    },
    {
      "name": "after a dropped socket the stream continues",
      "ws": {
        "drop": {
          "connection": 1,
          "afterSeconds": 1.2,
          "closeCode": 1011
        }
      },
      "steps": [
        {
          "open": {}
        },
        {
          "sendAudio": {
            "seconds": 2.0,
            "frameSeconds": 0.1
          }
        },
        {
          "finish": {}
        }
      ],
      "expect": {
        "connectionCount": 2,
        "eventTypesInclude": [
          "reconnecting"
        ],
        "lastSegmentEnd": 2.0,
        "connections": [
          {},
          {
            "config": {
              "timeline_offset_seconds": 1
            }
          }
        ]
      }
    },
    {
      "name": "a fatal config error ends the stream with its code",
      "ws": {
        "configError": {
          "code": "config_invalid",
          "message": "Unknown field chunk_strategy in the config.",
          "param": "chunk_strategy"
        }
      },
      "steps": [
        {
          "open": {
            "config": {
              "chunk_strategy": "x"
            }
          }
        }
      ],
      "expect": {
        "error": {
          "class": "LiveStreamError",
          "code": "config_invalid"
        },
        "connectionCount": 1
      }
    },
    {
      "name": "a refused handshake raises",
      "ws": {
        "reject": {
          "status": 401,
          "body": {
            "type": "error",
            "error": {
              "type": "authentication_error",
              "code": "invalid_api_key",
              "message": "Mock error.",
              "request_id": "req_case_1",
              "param": null
            },
            "request_id": "req_case_1"
          }
        }
      },
      "steps": [
        {
          "open": {}
        }
      ],
      "expect": {
        "error": {
          "class": "LiveStreamError",
          "codeOneOf": [
            "invalid_api_key",
            "handshake_failed"
          ]
        },
        "connectionCount": 1
      }
    }
  ]
}
