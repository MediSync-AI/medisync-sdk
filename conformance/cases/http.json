    {
      "name": "429 with retry-after is retried after that many seconds with the same key",
      "client": {
        "maxRetries": 2
      },
      "call": {
        "method": "coding.icd10gm",
        "args": {
          "path": [],
          "body": {
            "mentions": [
              {
                "id": "m1",
                "text": "Hypertonie"
              }
            ]
          }
        }
      },
      "responses": [
        {
          "status": 429,
          "headers": {
            "retry-after": "2"
          },
          "body": {
            "type": "error",
            "error": {
              "type": "rate_limit_error",
              "code": "rate_limit_exceeded",
              "message": "Mock error.",
              "request_id": "req_case_1",
              "param": null
            },
            "request_id": "req_case_1"
          }
        },
        {
          "status": 200,
          "body": {
            "results": []
          }
        }
      ],
      "expect": {
        "requestCount": 2,
        "sameHeaderAcrossRequests": "idempotency-key",
        "sleepsMs": [
          2000
        ],
        "result": {
          "notNull": true
        }
      }
    },
