<?xml version="1.0" encoding="utf-8"?>
<!-- MediSync only from the local feed of built packages; its dependencies from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="built" value="feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="built">
      <package pattern="MediSync" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
